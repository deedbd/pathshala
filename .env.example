# Pathshala runtime configuration. On cPanel install.php writes this file for you.
APP_ENV=production
APP_URL=https://school.example.com
APP_KEY=change-me-64-hex-chars
PORT=3000

# Database: mysql (cPanel), sqlite (zero-config fallback) or postgres (VPS)
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpaneluser_pathshala
DB_USER=cpaneluser_pathshala
DB_PASSWORD=
# DB_URL=postgres://user:pass@host:5432/pathshala   (overrides the fields above)
SQLITE_PATH=storage/sqlite/pathshala.db

# Adapters: queue,scheduler,storage,pdf,realtime  (cPanel → VPS: bullmq,cron,s3,chromium,websocket)
ADAPTERS=db,inprocess,local,pdfmake,sse
CRON_MODE=heartbeat
CRON_KEY=change-me

UPLOADS_DIR=uploads
DB_DIR=db

# Mail (cPanel SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pathshala <no-reply@school.example.com>"

# SMS: log (default) or http (BD gateway; {to} {text} placeholders in SMS_HTTP_URL)
SMS_PROVIDER=log
SMS_HTTP_URL=
SMS_HTTP_METHOD=GET
SMS_SENDER_ID=

# Web Push (VAPID) — generated by the installer when empty
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@school.example.com

# Cloudflare Turnstile (optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- the Pathshala team's own console (not a school's) -------------------------------------------
# The path its sign-in page lives behind. The installer writes a random one here and prints it once;
# /owner and /api/owner answer 404 to anyone who has not come through it, and with this empty the
# vendor console is closed altogether. It is not the security boundary — the role, the founder
# school, the password and the second factor are — it just keeps the door off the school's site.
OWNER_DOOR=
# Any one of the three below is enough to reach the door — a machine the owner has already trusted
# (a signed device cookie, set on the first sign-in and approved from a trusted session after that),
# an address on this list, or a MAC on the next one. With none of them set and no device trusted yet,
# the door is open to the password alone, so a fresh install cannot lock its owner out.
OWNER_IPS=
# Only meaningful when the server and the machine share a network: a MAC address does not cross the
# internet, so on shared hosting this never matches and the two rules above decide.
OWNER_MACS=
