{
  "name": "@pathshala/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Database layer: engine adapters (mysql, sqlite, postgres), boot-time migrations, seeds, generated Drizzle schema",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/mysql": {
      "types": "./dist/schema/mysql.d.ts",
      "import": "./dist/schema/mysql.js"
    },
    "./schema/sqlite": {
      "types": "./dist/schema/sqlite.d.ts",
      "import": "./dist/schema/sqlite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "gen": "node scripts/gen-drizzle.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "mysql2": "3.24.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
