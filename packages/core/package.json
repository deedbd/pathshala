{
  "name": "@pathshala/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Domain services: auth, tenancy, RBAC, audit, settings, files, automation engine, notifications, installer",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@pathshala/adapters": "workspace:*",
    "@pathshala/db": "workspace:*",
    "@pathshala/events": "workspace:*",
    "@pathshala/schemas": "workspace:*",
    "bcryptjs": "3.0.3",
    "json-logic-js": "2.0.5"
  },
  "devDependencies": {
    "@types/json-logic-js": "2.0.8",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
