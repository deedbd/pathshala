{
  "name": "pathshala",
  "private": true,
  "version": "0.1.0",
  "description": "Pathshala — automation-first school management platform (cPanel-first, portable)",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "node db/generate.mjs && node db/verify.mjs && node db/seeds/build-seeds.mjs && node packages/db/scripts/gen-drizzle.mjs",
    "check:native": "node scripts/check-native.mjs",
    "release:cpanel": "node scripts/build-release.mjs",
    "smoke": "node --test --test-concurrency=1 tests/smoke.test.mjs tests/phase1.test.mjs",
    "test:phase0": "node --test --test-concurrency=1 tests/smoke.test.mjs",
    "test:phase1": "node --test --test-concurrency=1 tests/phase1.test.mjs"
  },
  "devDependencies": {
    "archiver": "7.0.1",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
